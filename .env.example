# TerraPulse environment — everything runs without secrets.
# The demo agent can optionally use a real LLM; otherwise the deterministic
# rule-based planner is used (receipts record which planner ran).

# Optional: OpenAI-compatible endpoint for the live agent planner.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Public site URL (used in receipts and sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
